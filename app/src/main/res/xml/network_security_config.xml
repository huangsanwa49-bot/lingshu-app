<?xml version="1.0" encoding="utf-8"?>
<!-- 禁止明文 HTTP；不信任用户自己装的 CA。lingshu 的证书由 App 内的公钥固定校验。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
